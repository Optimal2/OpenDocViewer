{
  "name": "opendocviewer",
  "version": "2.11.0",
  "private": true,
  "description": "Fast, lightweight document viewer (PDF, TIFF, images) built with React + Vite, with a token-gated log server and runtime configuration.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Optimal2/OpenDocViewer.git"
  },
  "homepage": "https://github.com/Optimal2/OpenDocViewer#readme",
  "bugs": {
    "url": "https://github.com/Optimal2/OpenDocViewer/issues"
  },
  "keywords": [
    "pdf",
    "tiff",
    "viewer",
    "react",
    "vite",
    "document",
    "opendocviewer"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "build:standard-manual": "node scripts/build-standard-manual.mjs",
    "dev": "npm run build:standard-manual && vite",
    "build": "npm run build:standard-manual && vite build && node scripts/verify-ocr-lazy-chunk.mjs",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,scss,md}\"",
    "test": "npm run build:standard-manual && vitest run",
    "test:watch": "npm run build:standard-manual && vitest",
    "test:ui": "npm run build:standard-manual && playwright test",
    "doc": "jsdoc -c jsdoc.json",
    "doc:agent": "npm run build:standard-manual && node scripts/generate-agent-docs.mjs",
    "start:system-log": "node server/system-log-server.js",
    "start:user-log": "node server/user-log-server.js",
    "start:logs": "concurrently -n sys,user -c auto \"npm run start:system-log\" \"npm run start:user-log\"",
    "dev:system-log": "cross-env NODE_ENV=development PORT=3001 LOG_TOKEN=devtoken node server/system-log-server.js",
    "dev:user-log": "cross-env NODE_ENV=development PORT=3002 node server/user-log-server.js",
    "dev:logs": "concurrently -n sys,user -c auto \"npm run dev:system-log\" \"npm run dev:user-log\"",
    "dev:both": "concurrently -n app,logs -c auto \"npm run dev\" \"npm run dev:logs\"",
    "// release helpers": "Run one of the release:* scripts, then push with --follow-tags.",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\""
  },
  "dependencies": {
    "asn1js": "^4.0.0",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "i18next": "^26.7.2",
    "i18next-http-backend": "^4.0.10",
    "i18next-icu": "^2.7.0",
    "jspdf": "^4.2.1",
    "material-icons": "^1.13.14",
    "morgan": "^1.12.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.5.438",
    "pkijs": "^4.0.1",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/runtime": "^8.1.0",
    "@eslint/js": "^10.0.1",
    "@peculiar/x509": "^3.1.0",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/swe": "1.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "docdash": "^2.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdoc": "^4.0.5",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "rolldown": "^1.3.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "asynckit": "^0.5.0",
    "body-parser": "^2.4.0",
    "catharsis": "^0.11.0",
    "flatted": "^3.4.2",
    "linkify-it": "^5.0.2",
    "lodash": "^4.18.0",
    "mdn-data": "^2.37.2",
    "mime-db": "^1.54.0",
    "minimatch": "^11.0.4",
    "ms": "^2.1.3",
    "path-to-regexp": "^8.4.2",
    "picomatch": "^4.0.7",
    "regenerator-runtime": "^0.14.1",
    "safe-buffer": "^5.2.1",
    "shell-quote": "^1.12.0",
    "why-is-node-running": "^3.2.3",
    "yargs": "^18.2.0"
  }
}
